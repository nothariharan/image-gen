{
  "name": "image-gen-mcp",
  "version": "2.0.0",
  "type": "module",
  "description": "MCP server that generates images via ChatGPT/DALL-E by driving your real, logged-in Edge/Chrome browser over CDP — no API key, no token.",
  "main": "mcp-server.mjs",
