{
  "name": "image-gen-mcp",
  "version": "2.6.0",
  "type": "module",
  "description": "MCP image generation for AI agents via your ChatGPT browser session — no OpenAI API key. Includes a /chatgpt-image-gen skill so the agent calls generate_image instead of a built-in image tool.",
  "main": "mcp-server.mjs",
  "bin": {
    "image-gen-mcp": "mcp-server.mjs"
  },
  "scripts": {
    "login": "node login-once.mjs",
    "test-connection": "node setup-session.mjs",
    "start": "node mcp-server.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "image-generation",
    "dall-e",
    "chatgpt",
    "playwright",
    "claude-code",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nothariharan/image-gen.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright-core": "^1.44.0",
    "pngjs": "^7.0.0"
  }
}
